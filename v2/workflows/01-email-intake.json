      "name": "Get Gmail Message"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const m=$json;\nfunction htmlToText(s=''){return String(s).replace(/<style\\b[^>]*>[\\s\\S]*?<\\/style>/gi,' ').replace(/<script\\b[^>]*>[\\s\\S]*?<\\/script>/gi,' ').replace(/<(br|\\/p|\\/div|\\/li|\\/tr|\\/h[1-6])\\b[^>]*>/gi,'\\n').replace(/<[^>]+>/g,' ').replace(/&nbsp;/gi,' ').replace(/&amp;/gi,'&').replace(/&lt;/gi,'<').replace(/&gt;/gi,'>').replace(/&quot;/gi,'\"').replace(/&#39;/gi,\"'\").replace(/[ \\t]+/g,' ').replace(/\\n\\s*\\n\\s*\\n/g,'\\n\\n').trim();}\nconst body=String(m.textPlain||m.text||htmlToText(m.html||m.textHtml||'')).slice(0,12000);\nconst id=String(m.id||m.messageId||'');\nif(!id) throw new Error('MISSING_GMAIL_MESSAGE_ID');\nreturn {json:{gmail_message_id:id,thread_id:String(m.threadId||''),received_at:String(m.date||m.internalDate||new Date().toISOString()),sender:String(m.from?.text||m.from||''),recipient:String(m.to?.text||m.to||''),subject:String(m.subject||'(no subject)').slice(0,500),body,category:'uncertain',priority:1,requested_action:'unknown',summary:'',draft:'',evidence_json:'[]',risk_flags_json:'[]',model_confidence:0,state:'received',approval_actor_id:'',approval_expires_at:'',attempt_count:0,last_error_code:'',sent_message_id:''}};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -440,
        0
      ],
      "id": "i-normalize",
      "name": "Normalize + Bound Email"
    },
