      ],
      "id": "a-trigger",
      "name": "Telegram Callback Trigger"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const q=$json.callback_query;\nif(!q||typeof q.data!=='string'||!q.from||!q.message?.chat) throw new Error('INVALID_CALLBACK');\nconst [action,id,...extra]=q.data.split('|');\nif(!['approve','reject'].includes(action)||!id||extra.length) throw new Error('INVALID_CALLBACK_DATA');\nconst expectedUser='REPLACE_WITH_TELEGRAM_USER_ID';\nconst expectedChat='REPLACE_WITH_PRIVATE_TELEGRAM_CHAT_ID';\nif(expectedUser.startsWith('REPLACE_')||expectedChat.startsWith('REPLACE_')) throw new Error('CONFIGURE_TELEGRAM_ALLOWLIST_BEFORE_USE');\nif(String(q.from.id)!==expectedUser||String(q.message.chat.id)!==expectedChat) throw new Error('UNAUTHORIZED_APPROVAL');\nreturn {json:{action,gmail_message_id:id,actor_id:String(q.from.id),chat_id:String(q.message.chat.id),callback_query_id:String(q.id||'')}};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -660,
        0
      ],
      "id": "a-parse",
      "name": "Parse Callback + Fail Closed"
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "EmailDecisionLedger"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "gmail_message_id",
              "condition": "eq",
              "keyValue": "={{$('Parse Callback + Fail Closed').first().json.gmail_message_id}}"
            }
          ]
        },
        "returnAll": false,
        "limit": 1,
        "orderBy": false
      },
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        -410,
        0
      ],
      "id": "a-get",
      "name": "Load Decision Record"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const row=$json; const cb=$('Parse Callback + Fail Closed').first().json;\nif(row.gmail_message_id!==cb.gmail_message_id) throw new Error('LEDGER_ID_MISMATCH');\nif(row.state!=='pending_approval') throw new Error('DECISION_ALREADY_HANDLED_OR_NOT_PENDING');\nconst exp=Date.parse(row.approval_expires_at||''); if(!Number.isFinite(exp)||Date.now()>exp) throw new Error('APPROVAL_EXPIRED');\nif(!row.draft||typeof row.draft!=='string') throw new Error('DRAFT_MISSING');\nreturn {json:{...row,action:cb.action,actor_id:cb.actor_id,chat_id:cb.chat_id,callback_query_id:cb.callback_query_id}};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -160,
        0
      ],
      "id": "a-gate",
      "name": "Validate State + Expiry"
